# VOX-UI Backend — Environment Configuration
# Copy to .env and fill in your values.

# ── LiveKit ──────────────────────────────────────────────────────────────────
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_ROOM=vox-ui-room

# ── STT (OpenAI-compatible Whisper endpoint) ─────────────────────────────────
# Example: Jetson Faster-Whisper
# STT_URL=https://jetson-whisper.resonancegroupusa.com
STT_URL=http://localhost:9010
STT_MODEL=Systran/faster-distil-whisper-small.en

# ── LLM (OpenAI-compatible endpoint) ─────────────────────────────────────────
# Set LLM_PROVIDER to "custom" and provide LLM_BASE_URL for Hermes/vLLM/etc.
# Or set LLM_PROVIDER to "ollama" and use OLLAMA_MODEL.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:8642/v1
OLLAMA_MODEL=qwen3-30b-a3b-instruct:8k
LLM_API_KEY=dummy
LLM_TEMPERATURE=0.3
LLM_MAX_COMPLETION_TOKENS=512
LLM_DISABLE_THINKING=true

# ── TTS (OpenAI-compatible Kokoro endpoint) ───────────────────────────────────
# Example: Jetson Kokoro
# TTS_URL=https://jetson-kokoro.resonancegroupusa.com
TTS_URL=http://localhost:8880
TTS_VOICE=af_heart
TTS_SPEED=1.0

# ── Token service ─────────────────────────────────────────────────────────────
TOKEN_SERVICE_PORT=7882

# ── Voice agent ───────────────────────────────────────────────────────────────
BACKEND_ENABLED=false
TOOLS_ENABLED=false
MCP_ENABLED=false
SKIP_GREETING=false
LOG_LEVEL=INFO
